<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setSelectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light"
    tools:context=".SetSelectionActivity">

    <!-- Top App Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/secondary">

        <LinearLayout
            android:id="@+id/setSelectionHeaderContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvSetTableCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Table 1 • 2 Guests"
                android:textColor="@color/primary_light"
                android:textSize="12sp"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Meal Plan"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All guests at this table share the selected set package"
                android:textColor="#A1A1AA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Scrollable Set Cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <!-- ================= GUEST HEADCOUNT (PAX) ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeadCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Party Size"
                                android:textColor="@color/text_main"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Number of dining guests at table"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <!-- Quantity Stepper -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnMinusPax"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:text="−"
                                android:textSize="16sp"
                                android:textColor="@color/text_main"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:cornerRadius="19dp"
                                app:strokeColor="@color/divider_color" />

                            <TextView
                                android:id="@+id/tvPaxCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="90dp"
                                android:gravity="center"
                                android:text="2 Guests"
                                android:textColor="@color/text_main"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnPlusPax"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="38dp"
                                android:layout_height="38dp"
                                android:text="+"
                                android:textSize="16sp"
                                android:textColor="@color/text_main"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:padding="0dp"
                                app:cornerRadius="19dp"
                                app:strokeColor="@color/divider_color" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLockedPax"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Locked: Headcount fixed for active dining session"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SET MEAL A ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbSetA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text=""
                            android:buttonTint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:id="@+id/tvTitleSetA"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SET MEAL A • ₱399 / pax"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Typical Pork &amp; Banchan"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLockedA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cannot downgrade from higher set"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginTop="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Classic Plain Pork Belly (Samgyupsal)\n• Spicy Yangnyeom Pork Bulgogi\n• Sweet Soy Marinated Pork\n• Unlimited White Rice, Ssamjang, Lettuce &amp; Banchan"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SET MEAL B ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbSetB"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text=""
                            android:buttonTint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:id="@+id/tvTitleSetB"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SET MEAL B • ₱449 / pax"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pork + Unlimited Melted Cheese Dip"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvLockedB"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cannot downgrade from Set C"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:visibility="gone"
                        android:layout_marginTop="6dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• All 3 Signature Pork Varieties\n• Unlimited Melted Cheese Dip\n• Unlimited White Rice, Ssamjang, Lettuce &amp; Banchan"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ================= SET MEAL C ================= -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSetC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_card"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbSetC"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:text=""
                            android:buttonTint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="4dp">

                            <TextView
                                android:id="@+id/tvTitleSetC"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SET MEAL C • ₱499 / pax"
                                android:textColor="@color/text_main"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Premium Beef + Pork + Cheese Dip"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider_color"
                        android:layout_marginVertical="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Premium Beef Brisket &amp; Sweet Bulgogi Beef\n• All 3 Signature Pork Varieties\n• Unlimited Melted Cheese Dip\n• Unlimited Banchan, Rice, Dips &amp; Lettuce"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Confirmation Bar -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:id="@+id/setSelectionBottomContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedSetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected: SET A"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedSetDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Typical Pork"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmSet"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="Confirm Meal Plan"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                app:cornerRadius="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
